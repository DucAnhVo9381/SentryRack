<!-- Toolbar (action bar) menu - Deliverable 2 steps 16, 17, 18
     - Refresh : always|withText + actionLayout -> icon AND text always shown (step 18)
     - Alerts  : ifRoom, icon only (on the toolbar when there is space)
     - Help, Settings, Log out : never -> overflow menu (3 dots), no icons (step 17)
     @author Anvesh
     @date 2026-10-01 -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_refresh"
        android:icon="@drawable/ic_menu_refresh"
        android:title="@string/menu_refresh"
        app:showAsAction="always|withText" />

    <item
        android:id="@+id/action_alerts"
        android:icon="@drawable/ic_nav_alerts"
        android:title="@string/menu_alerts"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/action_help"
        android:title="@string/menu_help"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_settings"
        android:title="@string/menu_settings"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_logout"
        android:title="@string/menu_logout"
        app:showAsAction="never" />
</menu>