<?xml version="1.0" encoding="utf-8"?>
<!-- Contact support bottom sheet (opened from the 3-dot menu)
     3 rows: Email us / Call us / Visit website
     @author Anvesh
     @date 2026-10-08 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_padding"
    android:paddingEnd="@dimen/settings_padding"
    android:paddingBottom="@dimen/settings_padding">

    <!-- Grey handle bar at the top (drag down to close) -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_space_small"
        android:text="@string/contact_title"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <!-- Email us -->
    <LinearLayout
        android:id="@+id/contactEmailRow"
        style="@style/Widget.SentryRack.Settings.Row"
        android:background="?attr/selectableItemBackground">

        <ImageView
            style="@style/Widget.SentryRack.Settings.RowIcon"
            android:src="@drawable/ar_ic_contact_email" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.SentryRack.Settings.RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_email" />

            <TextView
                style="@style/Widget.SentryRack.Settings.RowSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_email_address" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/Widget.SentryRack.Settings.Divider" />

    <!-- Call us -->
    <LinearLayout
        android:id="@+id/contactCallRow"
        style="@style/Widget.SentryRack.Settings.Row"
        android:background="?attr/selectableItemBackground">

        <ImageView
            style="@style/Widget.SentryRack.Settings.RowIcon"
            android:src="@drawable/ar_ic_contact_call" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.SentryRack.Settings.RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_call" />

            <TextView
                style="@style/Widget.SentryRack.Settings.RowSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_call_hours" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/Widget.SentryRack.Settings.Divider" />

    <!-- Visit website -->
    <LinearLayout
        android:id="@+id/contactWebRow"
        style="@style/Widget.SentryRack.Settings.Row"
        android:background="?attr/selectableItemBackground">

        <ImageView
            style="@style/Widget.SentryRack.Settings.RowIcon"
            android:src="@drawable/ar_ic_contact_web" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.SentryRack.Settings.RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_web" />

            <TextView
                style="@style/Widget.SentryRack.Settings.RowSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_web_sub" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>