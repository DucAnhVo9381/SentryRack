<!-- Login screen - PORTRAIT layout (Deliverable 2 steps 11 and 14)
     Gradient + glow background, team logo, glass card with the form,
     Google button and Sign up link. All colors/sizes come from
     colors_login.xml, dimens.xml and styles_login.xml.
     @author Anvesh
     @date 2026-10-01 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_background"
    android:fillViewport="true"
    android:theme="@style/ThemeOverlay.SentryRack.Login"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/login_padding"
        android:paddingEnd="@dimen/login_padding"
        android:paddingBottom="@dimen/login_padding">

        <!--  Branding: logo (light/dark automatic), name, tagline  -->
        <ImageView
            android:id="@+id/loginLogo"
            android:layout_width="@dimen/login_logo_size"
            android:layout_height="@dimen/login_logo_size"
            android:contentDescription="@string/cd_app_logo"
            android:src="@drawable/splash_icon" />

        <TextView
            style="@style/Widget.SentryRack.Login.AppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/Widget.SentryRack.Login.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_tagline" />

        <!-- ===== Glass card with the form (shared file: login_form_card.xml) ===== -->
        <include
            layout="@layout/ar_login_form_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_space_large" />

        <!-- Don't have an account? Sign up -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_space_medium"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.SentryRack.Login.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_account" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signUpButton"
                style="@style/Widget.SentryRack.Login.LinkButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_sign_up" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>