<?xml version="1.0" encoding="utf-8"?>
<!-- Send feedback dialog (opened from the 3-dot menu)
     - Type chips: Bug / Idea / Other (one must be selected)
     - Message box with 500-character counter
     - App + Android version added automatically
     The title and Cancel / Send buttons come from MaterialAlertDialogBuilder in Java.
     @author Anvesh
     @date 2026-10-08 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/feedback_dialog_padding"
    android:paddingTop="@dimen/settings_space_small"
    android:paddingEnd="@dimen/feedback_dialog_padding">

    <!-- Feedback type: only one can be selected, Bug is selected by default -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/feedbackTypeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:checkedChip="@id/chipBug"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipBug"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_bug" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipIdea"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_idea" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOther"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_other" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Message box (grows up to 6 lines, counter shows 0/500) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/feedbackMessageLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_space_small"
        android:hint="@string/feedback_hint"
        app:counterEnabled="true"
        app:counterMaxLength="500">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/feedbackMessageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:maxLines="6"
            android:minHeight="@dimen/feedback_message_min_height" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- "App version 1.0 · Android 14 added automatically" (text set in Java) -->
    <TextView
        android:id="@+id/feedbackDeviceInfo"
        style="@style/Widget.SentryRack.Settings.RowSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_space_small" />
</LinearLayout>