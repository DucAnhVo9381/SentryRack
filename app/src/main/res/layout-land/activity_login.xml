<!-- Login screen - LANDSCAPE layout (Deliverable 2 step 14)
     Left half: logo, app name, tagline.  Right half: the same form card
     (login_form_card.xml) + Sign up, scrollable for small screens.
     Same view ids as portrait, so LoginActivity works with both.
     @author Anvesh
     @date 2026-10-01 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_background"
    android:baselineAligned="false"
    android:fitsSystemWindows="true"
    android:orientation="horizontal"
    android:theme="@style/ThemeOverlay.SentryRack.Login"
    tools:context=".LoginActivity">

    <!-- ===== Left: branding ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/login_padding">

        <ImageView
            android:id="@+id/loginLogo"
            android:layout_width="@dimen/login_logo_size"
            android:layout_height="@dimen/login_logo_size"
            android:contentDescription="@string/cd_app_logo"
            android:src="@drawable/splash_icon" />

        <TextView
            style="@style/Widget.SentryRack.Login.AppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/Widget.SentryRack.Login.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/login_tagline" />
    </LinearLayout>

    <!-- ===== Right: form card + Sign up ===== -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/login_padding">

            <include
                layout="@layout/ar_login_form_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_space_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.SentryRack.Login.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_no_account" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signUpButton"
                    style="@style/Widget.SentryRack.Login.LinkButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_sign_up" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>