<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- RUNTIME PERMISSION -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- APPLICATION CONFIGURATION & GLOBAL SETTINGS -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/homescreen_icon_light"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/homescreen_icon_light_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SentryRack.Splash">

        <!-- Login screen = app launcher. Splash (3s) shows first, then Login.-->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.SentryRack.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main screen - opened from LoginActivity after login.
             Launcher + splash moved to LoginActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.SentryRack"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>