<?xml version="1.0" encoding="utf-8"?>
<!-- Login screen - LANDSCAPE layout
     Left half: logo, app name, tagline.  Right half: the same form card
     (login_form_card.xml) + Sign up, scrollable for small screens.
     Same view ids as portrait, so LoginActivity works with both.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/login_background"
    android:theme="@style/ThemeOverlay.SentryRack.Login"
    tools:context=".view.LoginActivity">

    <!-- PARENT LAYOUT OF THE CONTENT INSIDE SCROLLVIEW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- ===== Left: form card + Sign up ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/login_padding">

            <!-- Login form card -->
            <include
                layout="@layout/login_form_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Sign up text -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_space_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/Widget.SentryRack.Login.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_no_account" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signUpButton"
                    style="@style/Widget.SentryRack.Login.LinkButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_sign_up" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Right: branding ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/login_padding">

            <ImageView
                android:id="@+id/loginLogo"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:contentDescription="SentryRack logo"
                android:scaleType="centerCrop"
                android:src="@drawable/login_logo" />

            <TextView
                style="@style/Widget.SentryRack.Login.AppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-40dp"
                android:text="Sentry Rack" />

            <TextView
                style="@style/Widget.SentryRack.Login.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rack-level monitoring platform" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>