<?xml version="1.0" encoding="utf-8"?>
<!-- Send feedbackData dialog (opened from the 3-dot menu)
     - Full name, phone number and email (all required)
     - Comment box with 500-character counter
     - 5-star rating (required)
     - App + Android version added automatically
     The title and Cancel / Send buttons come from MaterialAlertDialogBuilder in Java.
     @author Anvesh
     @date 2026-10-08 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/feedback_dialog_padding"
        android:paddingTop="@dimen/settings_space_small"
        android:paddingEnd="@dimen/feedback_dialog_padding">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/feedbackNameLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/feedback_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/feedbackNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/feedbackPhoneLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_space_small"
            android:hint="@string/feedback_phone_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/feedbackPhoneInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/feedbackEmailLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_space_small"
            android:hint="@string/feedback_email_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/feedbackEmailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Comment box (grows up to 6 lines, counter shows 0/500) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/feedbackMessageLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_space_small"
            android:hint="@string/feedback_hint"
            app:counterEnabled="true"
            app:counterMaxLength="500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/feedbackMessageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:maxLines="6"
                android:minHeight="@dimen/feedback_message_min_height" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_space_small"
            android:text="@string/feedback_rating_label"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <RatingBar
            android:id="@+id/feedbackRatingBar"
            style="?android:attr/ratingBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:rating="0"
            android:stepSize="1" />

        <!-- Shown by Java when no star is chosen -->
        <TextView
            android:id="@+id/feedbackRatingError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- "App version 1.0 · Android 14 added automatically" (text set in Java) -->
        <TextView
            android:id="@+id/feedbackDeviceInfo"
            style="@style/Widget.SentryRack.Settings.RowSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_space_small" />
    </LinearLayout>
</ScrollView>