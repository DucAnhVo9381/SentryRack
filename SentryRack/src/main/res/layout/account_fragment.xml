<?xml version="1.0" encoding="utf-8"?>
<!-- Account screen v2 (replaces the old design-only screen)
     Header: photo (custom, Google or default) + camera badge, name, email, Google badge, role chip.
     Profile: Name, Role, Profile photo. Security: Change password. Log out. Delete account.
     Everything is handled by AccountFragment -> ProfileController -> ProfileRepository (MVC).
     @author Anvesh Rachakonda
     @date 2026-11-22 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Header: same gradient as the Login screen ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:background="@drawable/login_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/user_header_padding">

            <FrameLayout
                android:id="@+id/accountPhotoFrame"
                android:layout_width="@dimen/user_avatar_size"
                android:layout_height="@dimen/user_avatar_size"
                android:clickable="true"
                android:contentDescription="@string/account_photo"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/accountPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_user_avatar"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/account_img_user_avatar"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/login_on_bg"
                    app:strokeWidth="3dp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:importantForAccessibility="no"
                    android:src="@drawable/account_camera_badge" />
            </FrameLayout>

            <TextView
                android:id="@+id/accountName"
                style="@style/Widget.SentryRack.User.Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/accountEmail"
                style="@style/Widget.SentryRack.User.Email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/accountGoogleBadge"
                style="@style/Widget.SentryRack.User.Email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_google_badge"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/accountRoleChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/account_role_chip_bg"
                android:paddingStart="12dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp"
                android:textColor="@color/login_on_bg"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/settings_padding">

            <TextView
                style="@style/Widget.SentryRack.Settings.SectionHeader"
                android:text="@string/account_section_profile" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SentryRack.Settings.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/rowAccountName"
                        style="@style/Widget.SentryRack.User.Row">
                        <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/account_ic_name" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Widget.SentryRack.Settings.RowTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/account_name" />
                            <TextView
                                style="@style/Widget.SentryRack.Settings.RowSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/account_name_summary" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/valueAccountName"
                            style="@style/Widget.SentryRack.Settings.RowValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/user_field_spacing"
                            android:ellipsize="end"
                            android:maxWidth="120dp"
                            android:maxLines="1" />
                        <ImageView
                            style="@style/Widget.SentryRack.User.Chevron"
                            android:src="@drawable/account_overflow_chevron_icon" />
                    </LinearLayout>
                    <View style="@style/Widget.SentryRack.Settings.Divider" />
                    <LinearLayout
                        android:id="@+id/rowAccountRole"
                        style="@style/Widget.SentryRack.User.Row">
                        <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/account_ic_role" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Widget.SentryRack.Settings.RowTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/account_role" />
                            <TextView
                                style="@style/Widget.SentryRack.Settings.RowSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/account_role_summary" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/valueAccountRole"
                            style="@style/Widget.SentryRack.Settings.RowValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/user_field_spacing"
                            android:ellipsize="end"
                            android:maxWidth="120dp"
                            android:maxLines="1" />
                        <ImageView
                            style="@style/Widget.SentryRack.User.Chevron"
                            android:src="@drawable/account_overflow_chevron_icon" />
                    </LinearLayout>
                    <View style="@style/Widget.SentryRack.Settings.Divider" />
                    <LinearLayout
                        android:id="@+id/rowAccountPhoto"
                        style="@style/Widget.SentryRack.User.Row">
                        <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/account_ic_photo" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Widget.SentryRack.Settings.RowTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/account_photo" />
                            <TextView
                                style="@style/Widget.SentryRack.Settings.RowSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/account_photo_summary" />
                        </LinearLayout>
                        <ImageView
                            style="@style/Widget.SentryRack.User.Chevron"
                            android:src="@drawable/account_overflow_chevron_icon" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.SentryRack.Settings.SectionHeader"
                android:text="@string/account_section_security" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SentryRack.Settings.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/rowAccountPassword"
                        style="@style/Widget.SentryRack.User.Row">
                        <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/account_ic_password" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Widget.SentryRack.Settings.RowTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/user_change_password" />
                            <TextView
                                android:id="@+id/summaryAccountPassword"
                                style="@style/Widget.SentryRack.Settings.RowSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/account_password_summary" />
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/chevronAccountPassword"
                            style="@style/Widget.SentryRack.User.Chevron"
                            android:src="@drawable/account_overflow_chevron_icon" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/user_button_height"
                android:layout_marginTop="@dimen/settings_padding"
                android:text="@string/user_logout" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SentryRack.Settings.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/rowAccountDelete"
                        style="@style/Widget.SentryRack.User.Row">
                        <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/account_ic_delete" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Widget.SentryRack.Settings.RowTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/account_delete"
                                android:textColor="?attr/colorError" />
                            <TextView
                                style="@style/Widget.SentryRack.Settings.RowSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/account_delete_summary" />
                        </LinearLayout>
                        <ImageView
                            style="@style/Widget.SentryRack.User.Chevron"
                            android:src="@drawable/account_overflow_chevron_icon" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
