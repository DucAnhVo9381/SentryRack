<?xml version="1.0" encoding="utf-8"?>
<!-- Login screen - PORTRAIT layout
     Gradient + glow background, team logo, glass card with the form,
     Google button and Sign up link. All colors/sizes come from
     colors_login.xml, dimens.xml and themes_login.xml.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/login_background"
    android:theme="@style/ThemeOverlay.SentryRack.Login"
    tools:context=".LoginActivity">

    <!-- PARENT LAYOUT OF THE CONTENT INSIDE SCROLL VIEW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/login_padding"
        android:paddingEnd="@dimen/login_padding"
        android:paddingBottom="@dimen/login_padding">

        <!--  Branding: logo (light/dark automatic), name, tagline  -->
        <ImageView
            android:id="@+id/loginLogo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_marginBottom="-40dp"
            android:scaleType="centerCrop"
            android:contentDescription="SentryRack logo"
            android:src="@drawable/login_logo"/>

        <TextView
            style="@style/Widget.SentryRack.Login.AppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back" />

        <TextView
            style="@style/Widget.SentryRack.Login.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to monitor your racks" />

        <!-- ===== Glass card with the form (shared file: login_form_card.xml) ===== -->
        <include
            layout="@layout/login_form_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_space_large" />

        <!-- Don't have an account? Sign up -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_space_medium"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Widget.SentryRack.Login.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_account" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signUpButton"
                style="@style/Widget.SentryRack.Login.LinkButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_sign_up" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>