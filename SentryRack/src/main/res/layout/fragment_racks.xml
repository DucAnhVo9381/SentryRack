                android:id="@+id/racksFilterGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@+id/chipFilterAll"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

