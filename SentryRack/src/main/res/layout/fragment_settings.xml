<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/settings_padding">

        <!-- Screen title  -->
        <TextView
            style="@style/Widget.SentryRack.Settings.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drawer_settings" />

        <TextView
            style="@style/Widget.SentryRack.Settings.RowSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_space_small"
            android:text="@string/settings_subtitle" />

        <!--   DISPLAY   -->
        <TextView
            style="@style/Widget.SentryRack.Settings.SectionHeader"
            android:text="@string/settings_group_display" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentryRack.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Lock screen to portrait  -->
                <LinearLayout style="@style/Widget.SentryRack.Settings.Row">

                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_set_portrait_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_lock_portrait" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_lock_portrait_summary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchLockPortrait"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/setting_lock_portrait" />
                </LinearLayout>

                <View style="@style/Widget.SentryRack.Settings.Divider" />

                <!-- Dark theme (design only) -->
                <LinearLayout style="@style/Widget.SentryRack.Settings.Row">
                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_set_theme_ic" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_dark_mode" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_dark_mode_summary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/setting_dark_mode" />
                </LinearLayout>

                <View style="@style/Widget.SentryRack.Settings.Divider" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- SENSOR UNITS - @author Anvesh Rachakonda @date 2026-11-16
             Tap a row to choose the unit; values are converted on screen only,
             Firebase always keeps the base unit (mm, A, W, ppb, ppm). -->
        <TextView
            style="@style/Widget.SentryRack.Settings.SectionHeader"
            android:text="@string/settings_group_sensor_units" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentryRack.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- setting_unit_coolant -->
                <LinearLayout
                    android:id="@+id/rowUnitCoolant"
                    style="@style/Widget.SentryRack.Settings.Row"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_ic_coolant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_unit_coolant" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_unit_coolant_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/valueUnitCoolant"
                        style="@style/Widget.SentryRack.Settings.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Widget.SentryRack.Settings.Divider" />

                <!-- setting_unit_current -->
                <LinearLayout
                    android:id="@+id/rowUnitCurrent"
                    style="@style/Widget.SentryRack.Settings.Row"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_ic_current" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_unit_current" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_unit_current_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/valueUnitCurrent"
                        style="@style/Widget.SentryRack.Settings.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Widget.SentryRack.Settings.Divider" />

                <!-- setting_unit_power -->
                <LinearLayout
                    android:id="@+id/rowUnitPower"
                    style="@style/Widget.SentryRack.Settings.Row"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_ic_power" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_unit_power" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_unit_power_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/valueUnitPower"
                        style="@style/Widget.SentryRack.Settings.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Widget.SentryRack.Settings.Divider" />

                <!-- setting_unit_tvoc -->
                <LinearLayout
                    android:id="@+id/rowUnitTvoc"
                    style="@style/Widget.SentryRack.Settings.Row"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_ic_tvoc" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_unit_tvoc" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_unit_air_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/valueUnitTvoc"
                        style="@style/Widget.SentryRack.Settings.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Widget.SentryRack.Settings.Divider" />

                <!-- setting_unit_eco2 -->
                <LinearLayout
                    android:id="@+id/rowUnitEco2"
                    style="@style/Widget.SentryRack.Settings.Row"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_ic_eco2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_unit_eco2" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_unit_air_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/valueUnitEco2"
                        style="@style/Widget.SentryRack.Settings.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Widget.SentryRack.Settings.Divider" />

                <!-- setting_decimals -->
                <LinearLayout
                    android:id="@+id/rowDecimals"
                    style="@style/Widget.SentryRack.Settings.Row"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_ic_decimals" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_decimals" />

                        <TextView
                            android:id="@+id/summaryDecimals"
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_decimals_summary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/valueDecimals"
                        style="@style/Widget.SentryRack.Settings.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.SentryRack.Settings.SectionHeader"
            android:text="@string/sensor_template_title" />

        <TextView
            style="@style/Widget.SentryRack.Settings.RowSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sensor_template_summary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentryRack.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplateCoolantLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_coolant">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplateCoolantInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sensorTemplateLeakSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sensor_template_leak" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplateCurrentLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_current">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplateCurrentInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplatePowerLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_power">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplatePowerInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sensorTemplateDoorSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sensor_template_door_open" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplateAqiLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_aqi">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplateAqiInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplateTvocLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_tvoc">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplateTvocInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplateEco2Layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_eco2">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplateEco2Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sensorTemplateSaveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/sensor_template_save"
                    android:textAllCaps="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- RESET - @author Anvesh Rachakonda @date 2026-11-16 -->
        <TextView
            style="@style/Widget.SentryRack.Settings.SectionHeader"
            android:text="@string/settings_group_reset" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentryRack.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- setting_reset_all -->
                <LinearLayout
                    android:id="@+id/rowResetAll"
                    style="@style/Widget.SentryRack.Settings.Row"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_ic_reset" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_reset_all"
                            android:textColor="?attr/colorError" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_reset_all_summary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>