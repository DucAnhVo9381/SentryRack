<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/settings_padding">

        <!-- Screen title  -->
        <TextView
            style="@style/Widget.SentryRack.Settings.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drawer_settings" />

        <TextView
            style="@style/Widget.SentryRack.Settings.RowSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_space_small"
            android:text="@string/settings_subtitle" />

        <!--   DISPLAY   -->
        <TextView
            style="@style/Widget.SentryRack.Settings.SectionHeader"
            android:text="@string/settings_group_display" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentryRack.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Lock screen to portrait  -->
                <LinearLayout style="@style/Widget.SentryRack.Settings.Row">

                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_set_portrait_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_lock_portrait" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_lock_portrait_summary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchLockPortrait"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/setting_lock_portrait" />
                </LinearLayout>

                <View style="@style/Widget.SentryRack.Settings.Divider" />

                <!-- Dark theme (design only) -->
                <LinearLayout style="@style/Widget.SentryRack.Settings.Row">
                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_set_theme_ic" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_dark_mode" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_dark_mode_summary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/setting_dark_mode" />
                </LinearLayout>

                <View style="@style/Widget.SentryRack.Settings.Divider" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--  NOTIFICATIONS   -->
        <TextView
            style="@style/Widget.SentryRack.Settings.SectionHeader"
            android:text="@string/settings_group_notifications" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentryRack.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Critical alert sound (design only) -->
                <LinearLayout style="@style/Widget.SentryRack.Settings.Row">
                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_alert_sound_ic" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_sound" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_sound_summary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:contentDescription="@string/setting_sound" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- MONITORING -->
        <TextView
            style="@style/Widget.SentryRack.Settings.SectionHeader"
            android:text="@string/settings_group_monitoring" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentryRack.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Temperature unit (design only) -->
                <LinearLayout style="@style/Widget.SentryRack.Settings.Row">
                    <ImageView style="@style/Widget.SentryRack.Settings.RowIcon" android:src="@drawable/settings_set_temp_unit_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_temp_unit" />

                        <TextView
                            style="@style/Widget.SentryRack.Settings.RowSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_temp_unit_summary" />
                    </LinearLayout>

                    <TextView
                        style="@style/Widget.SentryRack.Settings.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_temp_unit_value" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.SentryRack.Settings.SectionHeader"
            android:text="@string/sensor_template_title" />

        <TextView
            style="@style/Widget.SentryRack.Settings.RowSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sensor_template_summary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentryRack.Settings.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplateCoolantLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_coolant">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplateCoolantInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sensorTemplateLeakSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sensor_template_leak" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplateCurrentLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_current">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplateCurrentInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplatePowerLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_power">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplatePowerInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sensorTemplateDoorSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sensor_template_door_open" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplateAqiLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_aqi">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplateAqiInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplateTvocLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_tvoc">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplateTvocInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sensorTemplateEco2Layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sensor_template_eco2">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/sensorTemplateEco2Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sensorTemplateSaveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/sensor_template_save"
                    android:textAllCaps="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>