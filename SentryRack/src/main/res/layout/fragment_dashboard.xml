<!-- Home screen (dashboard) - portrait layout
     Deliverable 2 steps 4, 5, 12, 23, 24, 25: full design without functionality,
     6 images, card elevation, and only styles / dimens / colors / strings (nothing hardcoded).
     Values shown are sample data; live sensor data will replace them in a later deliverable.
     @author Krushna
     @date 2026-10-03 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kp_bg_dashboard"
    android:fillViewport="true"
    android:theme="@style/ThemeOverlay.SentryRack.Dashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dash_padding">

        <!-- Header: title, location and overall status pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.SentryRack.Dashboard.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_title" />

                <TextView
                    style="@style/Widget.SentryRack.Dashboard.ScreenSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dash_space_xsmall"
                    android:text="@string/home_subtitle" />
            </LinearLayout>

            <TextView
                style="@style/Widget.SentryRack.Dashboard.StatusChip.Warning"
                android:layout_marginStart="@dimen/dash_space_small"
                android:text="@string/home_status_chip" />
        </LinearLayout>

        <!-- Main summary card (4dp elevation so it stands out) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentryRack.Dashboard.HeroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dash_space_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dash_hero_image_size"
                    android:layout_height="@dimen/dash_hero_image_size"
                    android:contentDescription="@string/cd_rack_image"
                    android:scaleType="fitCenter"
                    android:src="@drawable/kp_img_rack" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dash_space_large"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.HeroValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_racks_count" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.HeroLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_racks_label"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.HeroLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dash_space_xsmall"
                        android:text="@string/home_racks_breakdown" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live sensors: 2 x 2 grid of cards -->
        <TextView
            style="@style/Widget.SentryRack.Dashboard.SectionHeader"
            android:text="@string/home_section_sensors" />

        <!-- Row 1: temperature + coolant -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SentryRack.Dashboard.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/dash_space_xsmall"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        style="@style/Widget.SentryRack.Dashboard.StatIcon"
                        android:src="@drawable/kp_img_temperature" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dash_space_small"
                        android:text="@string/home_sensor_temperature" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_sensor_temperature_value" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.StatusChip.Ok"
                        android:layout_marginTop="@dimen/dash_space_small"
                        android:text="@string/home_state_normal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SentryRack.Dashboard.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dash_space_xsmall"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        style="@style/Widget.SentryRack.Dashboard.StatIcon"
                        android:src="@drawable/kp_img_coolant" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dash_space_small"
                        android:text="@string/home_sensor_coolant" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_sensor_coolant_value" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.StatusChip.Ok"
                        android:layout_marginTop="@dimen/dash_space_small"
                        android:text="@string/home_state_normal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Row 2: power + air quality -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dash_space_small"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SentryRack.Dashboard.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/dash_space_xsmall"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        style="@style/Widget.SentryRack.Dashboard.StatIcon"
                        android:src="@drawable/kp_img_power" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dash_space_small"
                        android:text="@string/home_sensor_power" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_sensor_power_value" />

                    <!-- Power is high on Rack B-01, so this one shows a warning -->
                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.StatusChip.Warning"
                        android:layout_marginTop="@dimen/dash_space_small"
                        android:text="@string/home_state_high" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SentryRack.Dashboard.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dash_space_xsmall"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        style="@style/Widget.SentryRack.Dashboard.StatIcon"
                        android:src="@drawable/kp_img_air" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dash_space_small"
                        android:text="@string/home_sensor_air" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_sensor_air_value" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.StatusChip.Ok"
                        android:layout_marginTop="@dimen/dash_space_small"
                        android:text="@string/home_state_good" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Rack access (door lock sensor) -->
        <TextView
            style="@style/Widget.SentryRack.Dashboard.SectionHeader"
            android:text="@string/home_section_access" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentryRack.Dashboard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.SentryRack.Dashboard.StatIcon"
                    android:src="@drawable/kp_img_door" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dash_space_medium"
                    android:layout_marginEnd="@dimen/dash_space_small"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_access_title" />

                    <TextView
                        style="@style/Widget.SentryRack.Dashboard.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dash_space_xsmall"
                        android:text="@string/home_access_last" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.SentryRack.Dashboard.StatusChip.Ok"
                    android:text="@string/home_access_badge" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent activity: latest events with a colored dot for the severity -->
        <TextView
            style="@style/Widget.SentryRack.Dashboard.SectionHeader"
            android:text="@string/home_section_activity" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentryRack.Dashboard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Event 1: warning (orange dot) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        style="@style/Widget.SentryRack.Dashboard.Dot"
                        android:backgroundTint="@color/status_warning" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Dashboard.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_activity_1" />

                        <TextView
                            style="@style/Widget.SentryRack.Dashboard.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_activity_1_time" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/Widget.SentryRack.Dashboard.Divider" />

                <!-- Event 2: critical (red dot) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        style="@style/Widget.SentryRack.Dashboard.Dot"
                        android:backgroundTint="@color/status_critical" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Dashboard.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_activity_2" />

                        <TextView
                            style="@style/Widget.SentryRack.Dashboard.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_activity_2_time" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/Widget.SentryRack.Dashboard.Divider" />

                <!-- Event 3: normal (green dot) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        style="@style/Widget.SentryRack.Dashboard.Dot"
                        android:backgroundTint="@color/status_ok" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.SentryRack.Dashboard.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_activity_3" />

                        <TextView
                            style="@style/Widget.SentryRack.Dashboard.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_activity_3_time" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>