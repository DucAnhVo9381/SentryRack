<?xml version="1.0" encoding="utf-8"?>
<!-- Login form card (glass look). Shared by the portrait AND landscape login
     layouts using <include>, so the form is written only once (DRY principle).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Outlined"
    android:id="@+id/loginCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/login_glass_corner"
    app:contentPadding="@dimen/login_padding"
    app:strokeWidth="@dimen/login_stroke_width"
    app:strokeColor="@color/login_glass_stroke"
    app:cardBackgroundColor="@color/login_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.SentryRack.Login.TextField"
            android:id="@+id/emailLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_space_medium"
            android:hint="@string/login_email_hint"
            app:startIconDrawable="@drawable/login_email_icon">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.SentryRack.Login.EditText"
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password (eye icon = built-in password_toggle) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.SentryRack.Login.TextField"
            android:id="@+id/passwordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_space_small"
            android:hint="@string/login_password_hint"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/login_password_icon">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.SentryRack.Login.EditText"
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Remember me ............ Forgot password? -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.checkbox.MaterialCheckBox
                style="@style/Widget.SentryRack.Login.CheckBox"
                android:id="@+id/rememberMeCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/login_remember_me" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.SentryRack.Login.LinkButton"
                android:id="@+id/forgotPasswordButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_forgot_password" />
        </LinearLayout>

        <!-- Log in -->
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.SentryRack.Login.PrimaryButton"
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_button_height"
            android:layout_marginTop="@dimen/login_space_small"
            android:text="Sign In" />

        <!-- ──── OR ──── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_space_medium"
            android:layout_marginBottom="@dimen/login_space_medium"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/login_divider_height"
                android:layout_weight="1"
                android:background="@color/login_divider" />

            <TextView
                style="@style/Widget.SentryRack.Login.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/login_space_medium"
                android:layout_marginEnd="@dimen/login_space_medium"
                android:text="@string/login_or" />

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/login_divider_height"
                android:layout_weight="1"
                android:background="@color/login_divider" />
        </LinearLayout>

        <!-- Continue with Google -->
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.SentryRack.Login.OutlinedButton"
            android:id="@+id/googleButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_button_height"
            android:text="@string/login_google" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>