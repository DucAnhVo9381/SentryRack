<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/activityScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/activityContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- SCREEN TITLE -->
        <TextView
            android:id="@+id/activityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activity"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/activitySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System-wide records and lifecycle history"
            android:textSize="16sp" />

        <!-- TABS -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/activityTabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:tabIndicatorFullWidth="true"
            app:tabGravity="fill"
            app:tabMode="fixed">

            <com.google.android.material.tabs.TabItem
                android:text="Records" />

            <com.google.android.material.tabs.TabItem
                android:text="Management Log" />

        </com.google.android.material.tabs.TabLayout>

        <!-- FILTER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <Spinner
                android:id="@+id/activityFilterSpinner"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:paddingHorizontal="12dp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/activityHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/activityHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Activity"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/activityHeaderDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="•" />

            <TextView
                android:id="@+id/activityTotalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="0 Events" />

        </LinearLayout>

        <!-- RECYCLER VIEW -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activityRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>