<?xml version="1.0" encoding="utf-8"?>
<!-- Overflow menu item highlight
     - hovered (mouse) / selected (keyboard) / pressed (finger) -> rounded grey box
     - tap -> grey ripple wave inside the same rounded box
     @author Anvesh
     @date 2026-10-08 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/menu_ripple">

    <!-- Mask: keeps the ripple inside the rounded box -->
    <item android:id="@android:id/mask">
        <inset
            android:insetLeft="6dp"
            android:insetRight="6dp">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white" />
                <corners android:radius="10dp" />
            </shape>
        </inset>
    </item>

    <!-- Grey box -->
    <item>
        <selector>
            <item android:state_hovered="true">
                <inset android:insetLeft="6dp" android:insetRight="6dp">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/menu_highlight" />
                        <corners android:radius="10dp" />
                    </shape>
                </inset>
            </item>
            <item android:state_pressed="true">
                <inset android:insetLeft="6dp" android:insetRight="6dp">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/menu_highlight" />
                        <corners android:radius="10dp" />
                    </shape>
                </inset>
            </item>
            <item android:state_selected="true">
                <inset android:insetLeft="6dp" android:insetRight="6dp">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/menu_highlight" />
                        <corners android:radius="10dp" />
                    </shape>
                </inset>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
</ripple>