<?xml version="1.0" encoding="utf-8"?>
<!-- Dark "tech dashboard" background for the Home and Racks screens.
     Layer 1: deep navy top-to-bottom gradient.
     Layer 2: faint circuit grid (app_bg_grid.xml).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Base gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/app_bg_bottom"
                android:startColor="@color/app_bg_top"
                android:type="linear" />
        </shape>
    </item>

    <!-- 2. Circuit grid -->
    <item android:drawable="@drawable/app_bg_grid" />
</layer-list>