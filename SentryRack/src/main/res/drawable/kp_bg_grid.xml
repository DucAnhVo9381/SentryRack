        android:fillColor="@color/dash_circuit_node"
        android:pathData="M144,192m-3,0a3,3 0,1 0,6 0a3,3 0,1 0,-6 0 M216,384m-3,0a3,3 0,1 0,6 0a3,3 0,1 0,-6 0 M120,624m-3,0a3,3 0,1 0,6 0a3,3 0,1 0,-6 0 M192,744m-3,0a3,3 0,1 0,6 0a3,3 0,1 0,-6 0 M72,120m-2,0a2,2 0,1 0,4 0a2,2 0,1 0,-4 0 M288,264m-2,0a2,2 0,1 0,4 0a2,2 0,1 0,-4 0 M48,504m-2,0a2,2 0,1 0,4 0a2,2 0,1 0,-4 0 M264,672m-2,0a2,2 0,1 0,4 0a2,2 0,1 0,-4 0" />
