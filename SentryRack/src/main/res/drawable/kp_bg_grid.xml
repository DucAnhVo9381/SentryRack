<!-- Faint "circuit board" grid drawn over the dashboard background:
     thin grid lines every 24 units + a few cyan circuit traces with round nodes.
     Used as a layer inside kp_bg_dashboard.xml.
     @author Krushna
     @date 2026-10-03 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="360dp"
    android:height="780dp"
    android:viewportWidth="360"
    android:viewportHeight="780">

    <!-- Vertical grid lines -->
    <path
        android:pathData="M0,0V780 M24,0V780 M48,0V780 M72,0V780 M96,0V780 M120,0V780 M144,0V780 M168,0V780 M192,0V780 M216,0V780 M240,0V780 M264,0V780 M288,0V780 M312,0V780 M336,0V780 M360,0V780"
        android:strokeWidth="0.6"
        android:strokeColor="@color/dash_grid_line" />

    <!-- Horizontal grid lines -->
    <path
        android:pathData="M0,0H360 M0,24H360 M0,48H360 M0,72H360 M0,96H360 M0,120H360 M0,144H360 M0,168H360 M0,192H360 M0,216H360 M0,240H360 M0,264H360 M0,288H360 M0,312H360 M0,336H360 M0,360H360 M0,384H360 M0,408H360 M0,432H360 M0,456H360 M0,480H360 M0,504H360 M0,528H360 M0,552H360 M0,576H360 M0,600H360 M0,624H360 M0,648H360 M0,672H360 M0,696H360 M0,720H360 M0,744H360 M0,768H360"
