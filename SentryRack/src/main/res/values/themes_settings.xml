<?xml version="1.0" encoding="utf-8"?>

<!-- Settings screen styles: each setting row looks the same without repeating
     attributes in the layout. Colors come from the app theme,so they work in light and dark mode automatically.
     @author Anvesh -->
<resources>

    <!-- Screen title ("Settings") -->
    <style name="Widget.SentryRack.Settings.ScreenTitle" parent="">
        <item name="android:textSize">@dimen/settings_title_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Group header ("Display", "Notifications", "Monitoring") -->
    <style name="Widget.SentryRack.Settings.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/settings_section_margin</item>
        <item name="android:layout_marginBottom">@dimen/settings_row_padding</item>
        <item name="android:textSize">@dimen/settings_header_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Card that holds one group of settings (2dp elevation) -->
    <style name="Widget.SentryRack.Settings.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/settings_card_corner</item>
        <item name="cardElevation">@dimen/settings_card_elevation</item>
        <item name="contentPaddingLeft">@dimen/settings_padding</item>
        <item name="contentPaddingRight">@dimen/settings_padding</item>
    </style>

    <!-- One setting row: text on the left, switch/value on the right -->
    <style name="Widget.SentryRack.Settings.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/settings_row_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">@dimen/settings_row_padding</item>
        <item name="android:paddingBottom">@dimen/settings_row_padding</item>
    </style>

    <!-- Setting name -->
    <style name="Widget.SentryRack.Settings.RowTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Small grey description under the setting name -->
    <style name="Widget.SentryRack.Settings.RowSummary" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Current value on the right ("English", "5 s", "°C") -->
    <style name="Widget.SentryRack.Settings.RowValue" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Thin line between rows -->
    <style name="Widget.SentryRack.Settings.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_divider_height</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <!-- Image on the left of each setting row (step 12 images)
     @author Anvesh
     @date 2026-10-01 -->
    <style name="Widget.SentryRack.Settings.RowIcon" parent="">
        <item name="android:layout_width">@dimen/settings_icon_size</item>
        <item name="android:layout_height">@dimen/settings_icon_size</item>
        <item name="android:layout_marginEnd">@dimen/settings_padding</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- ===== Settings v2 - @author Anvesh @date 2026-11-02 ===== -->

    <!-- A row you can tap (ripple effect), built on the normal Row -->
    <style name="Widget.SentryRack.Settings.ClickRow" parent="Widget.SentryRack.Settings.Row">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Middle part of a row: title + summary, fills the free space -->
    <style name="Widget.SentryRack.Settings.RowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Title / summary that size themselves (so rows need fewer lines) -->
    <style name="Widget.SentryRack.Settings.RowTitleText" parent="Widget.SentryRack.Settings.RowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.SentryRack.Settings.RowSummaryText" parent="Widget.SentryRack.Settings.RowSummary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Value on the right ("System", "Normal", "1.0") -->
    <style name="Widget.SentryRack.Settings.RowValueText" parent="Widget.SentryRack.Settings.RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/settings_value_gap</item>
    </style>

    <!-- Small round preview next to a value (app icon, avatar colour) -->
    <style name="Widget.SentryRack.Settings.Preview" parent="">
        <item name="android:layout_width">@dimen/settings_preview_size</item>
        <item name="android:layout_height">@dimen/settings_preview_size</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Arrow (›) at the end of rows that open something -->
    <style name="Widget.SentryRack.Settings.Chevron" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/settings_value_gap</item>
        <item name="android:src">@drawable/account_overflow_chevron_icon</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Switch at the end of a row -->
    <style name="Widget.SentryRack.Settings.Switch" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>