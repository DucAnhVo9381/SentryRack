    <string name="help_title">Help center</string>
    <string name="help_search_hint">Search help</string>
    <string name="help_faq_header">Frequently asked</string>
    <string name="help_no_results">No matching questions</string>
    <string name="help_q1">What do the rack colours mean?</string>
    <string name="help_a1">Green means the rack is working normally, yellow is a warning, and red is a critical problem that needs attention right away.</string>
    <string name="help_q2">How do I change my password?</string>
    <string name="help_a2">Open the User tab at the bottom, tap Change password, then enter your current password and your new one twice.</string>
    <string name="help_q3">Why is a rack offline?</string>
    <string name="help_a3">The rack sensor has stopped sending data. Check its power and network cable, then tap Refresh.</string>
    <string name="help_q4">How do I lock portrait mode?</string>
    <string name="help_a4">Open Settings from the side menu and turn on Lock portrait.</string>
    <string name="help_q5">What does the current sensor measure?</string>
    <string name="help_a5">Each rack has an ACS723 current sensor that measures how much electrical current the rack is using, so overloads can be caught early.</string>

