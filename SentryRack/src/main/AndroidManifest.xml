<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- RUNTIME PERMISSION -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" /> <!-- Settings > Vibration -->

    <!-- APPLICATION CONFIGURATION & GLOBAL SETTINGS -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/homescreen_icon_light"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/homescreen_icon_light_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SentryRack.Splash">

        <!-- Login screen. The launcher entries are the 3 aliases below
     (Settings > App icon turns one on and the others off). -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.SentryRack.Splash"
            android:windowSoftInputMode="adjustResize" />

        <!-- Settings > App icon: 3 home-screen icons, only ONE is enabled at a time
             Blue is the default. @author Anvesh @date 2026-11-04 -->
        <activity-alias
            android:name=".IconBlue"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/homescreen_icon_light"
            android:roundIcon="@mipmap/homescreen_icon_light_round"
            android:targetActivity=".LoginActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/homescreen_icon_dark"
            android:roundIcon="@mipmap/homescreen_icon_dark_round"
            android:targetActivity=".LoginActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/homescreen_icon_gold"
            android:roundIcon="@mipmap/homescreen_icon_gold_round"
            android:targetActivity=".LoginActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Main screen - opened from LoginActivity after login.
             Launcher + splash moved to LoginActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.SentryRack"
            android:windowSoftInputMode="adjustResize" />
        <!-- @author Anvesh Rachakonda @date 2026-11-06 : Sign up screen -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.SentryRack"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>